{
  "expo": {
    "newArchEnabled": true,
    "name": "TastyPlates",
    "slug": "tastyplates",
    "description": "TastyPlates — restaurant discovery, reviews, and food stories from people whose taste you trust.",
    "version": "1.1.1",
    "orientation": "portrait",
    "icon": "./assets/AppIcons/appstore.png",
    "scheme": "tastyplates",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#ff7c0a",
    "runtimeVersion": "1.1.1",
    "splash": {
      "image": "./assets/splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#31343F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "buildNumber": "7",
      "bundleIdentifier": "com.bana.tastyplates-dev",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "TastyPlates"
      }
    },
    "android": {
      "package": "com.bana.tastyplates.dev",
      "icon": "./assets/AppIcons/playstore.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/AppIcons/playstore.png",
        "backgroundColor": "#ff7c0a"
      }
    },
    "extra": {
      "eas": {
        "projectId": "b9f29178-9903-42b6-94e6-e7ea221e45fc"
      },
      "router": {}
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/AppIcons/appstore.png",
      "name": "TastyPlates",
      "shortName": "TastyPlates",
      "description": "TastyPlates — restaurant discovery, reviews, and food stories from people whose taste you trust.",
      "themeColor": "#ff7c0a"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-logo.png",
          "resizeMode": "contain",
          "backgroundColor": "#31343F",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "myeung-bana"
  }
}
