{
  "expo": {
    "newArchEnabled": true,
    "name": "TastyPlates",
    "slug": "tastyplates",
    "description": "TastyPlates — restaurant discovery, reviews, and food stories from people whose taste you trust.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/AppIcons/appstore.png",
    "scheme": "tastyplates",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#ff7c0a",
    "runtimeVersion": "1.0.0",
    "splash": {
      "image": "./assets/AppIcons/appstore.png",
      "resizeMode": "contain",
      "backgroundColor": "#ff7c0a"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.toyama.rodrigo.expo-router-template",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleDisplayName": "TastyPlates"
      }
    },
    "android": {
      "package": "com.toyama.rodrigo.exporoutertemplate",
      "icon": "./assets/AppIcons/playstore.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/AppIcons/playstore.png",
        "backgroundColor": "#ff7c0a"
      }
    },
    "extra": {
      "eas": {
        "projectId": "b9f29178-9903-42b6-94e6-e7ea221e45fc"
      },
      "router": {}
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/AppIcons/appstore.png",
      "name": "TastyPlates",
      "shortName": "TastyPlates",
      "description": "TastyPlates — restaurant discovery, reviews, and food stories from people whose taste you trust.",
      "themeColor": "#ff7c0a"
    },
    "plugins": ["expo-router", "expo-font", "expo-web-browser", "expo-secure-store"],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "myeung-bana"
  }
}
