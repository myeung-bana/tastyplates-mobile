# ─── Nhost (required for app data) ─────────────────────────────────────────────
EXPO_PUBLIC_NHOST_SUBDOMAIN=
EXPO_PUBLIC_NHOST_REGION=
# Functions base from Nhost dashboard — must include /v1 (no trailing slash).
# Example: https://YOUR_SUBDOMAIN.functions.YOUR_REGION.nhost.run/v1
# Appends paths like restaurants-v2/get-restaurants → .../v1/restaurants-v2/get-restaurants
EXPO_PUBLIC_NHOST_FUNCTIONS_URL=
# After changing .env, restart Metro with a clear cache: npx expo start -c
# EAS builds: set the same EXPO_PUBLIC_* values in Expo project Environment / Secrets so release builds match local.

# Optional Next marketing API fallback (home/articles)
EXPO_PUBLIC_WEB_API_URL=

# ─── Editorial / browse defaults ───────────────────────────────────────────────
EXPO_PUBLIC_DEFAULT_LOCATION_SLUG=tokyo

# ─── Google Maps / Places REST (TastyStudio: add-review + My Lists) ─────────────
# Enable Places API (legacy) Autocomplete + Place Details + optional Geocode.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
